# Cadena de conexión a la base de Supabase, usada por el agente y el panel web.
# Dashboard de Supabase → botón Connect → pestaña "Session pooler".
# Reemplazar [YOUR-PASSWORD], corchetes incluidos, por la contraseña de la base.
#
# Este archivo es una plantilla: copiarlo a .env y completarlo.
# El .env real no se sube al repositorio (está en .gitignore).

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
