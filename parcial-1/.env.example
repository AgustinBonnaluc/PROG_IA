# Cadena de conexión a la base de Supabase, usada solo por el panel web.
# Dashboard de Supabase → Project Settings → Database → Connection string → URI
# Reemplazar [YOUR-PASSWORD] por la contraseña de la base.
#
# Este archivo es una plantilla: copiarlo a .env y completarlo.

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
